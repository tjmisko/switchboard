[Unit]
Description=Switchboard — coding agent status tracker and navigator
# Order after / stop with the graphical session where a compositor uses that
# target, but do NOT gate startup on it (see [Install]).
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Machine-local drop-ins may override these values without replacing ExecStart.
# Keeping backend discovery in this shared unit means a local binary path or a
# remote-host list cannot accidentally pin one machine to another machine's WM
# startup logic. See docs/machine-configuration.md.
Environment=SWITCHBOARD_BIN=%h/go/bin/switchboard
Environment=SWITCHBOARD_ARGS=
# Bind the WM backend even when the user manager never inherited the graphical
# session env (login race, OOM restart, or a bare `systemctl --user restart`).
# Hyprland is discovered from its live lock file; i3 is discovered from its live
# IPC socket. A compositor-imported environment remains the fast path for both.
# Without this, detection reports wm=none and the daemon silently drops to the
# Observe tier — chips render but focus is a no-op.
# `exec` hands the PID to the daemon so Type=simple/Restart tracking stays exact.
ExecStart=/bin/sh -c 'if [ -z "$$HYPRLAND_INSTANCE_SIGNATURE" ]; then for d in "$$XDG_RUNTIME_DIR"/hypr/*/; do [ -r "$$d/hyprland.lock" ] || continue; read -r p _ < "$$d/hyprland.lock"; [ -e "/proc/$$p" ] || continue; s=$${d%%/}; HYPRLAND_INSTANCE_SIGNATURE=$${s##*/}; export HYPRLAND_INSTANCE_SIGNATURE; break; done; fi; if [ -z "$$SWAYSOCK" ] && [ -z "$$I3SOCK" ]; then for s in "$$XDG_RUNTIME_DIR"/i3/ipc-socket.*; do [ -S "$$s" ] || continue; p=$${s##*.}; [ -e "/proc/$$p" ] || continue; I3SOCK=$$s; export I3SOCK; break; done; fi; if [ -n "$$I3SOCK" ] && [ -z "$$DISPLAY" ]; then DISPLAY=:0; export DISPLAY; fi; exec "$$0" "$$@"' ${SWITCHBOARD_BIN} $SWITCHBOARD_ARGS
Restart=always
RestartSec=2
# Fast path: the compositor/WM may import these into the user-manager
# environment at login. ExecStart can self-discover Hyprland and i3, while
# DISPLAY/XAUTHORITY still come from the graphical session when available.
PassEnvironment=HYPRLAND_INSTANCE_SIGNATURE SWAYSOCK I3SOCK DISPLAY XAUTHORITY XDG_RUNTIME_DIR XDG_CACHE_HOME
NoNewPrivileges=true

[Install]
# Want from default.target, not graphical-session.target. The compositor
# activates graphical-session.target (if at all) exactly once at login; when the
# per-user `systemd --user` is restarted on its own — e.g. it was OOM-killed and
# re-spawned by the system manager — that target is never re-reached, so a unit
# wanted only by it would stay dead. Every user-manager start reaches
# default.target, so the daemon recovers automatically and retries until
# Hyprland is reachable.
WantedBy=default.target
