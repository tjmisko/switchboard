[Unit]
Description=Switchboard — Polybar renderer
PartOf=graphical-session.target
# Do not order this renderer after switchboard.service. A target is implicitly
# ordered after units in its Wants= set, while switchboard.service is ordered
# after graphical-session.target; adding After=switchboard.service here closes
# a startup cycle. The renderer reconnects while the daemon is unavailable.
Wants=switchboard.service
ConditionPathExists=%h/.config/polybar/switchboard.ini

[Service]
Type=simple
# Both values are data-only override seams for machine-local drop-ins.
Environment=SWITCHBOARD_POLYBAR_BIN=/usr/bin/polybar
Environment=SWITCHBOARD_POLYBAR_CONFIG=%h/.config/polybar/switchboard.ini
ExecStart=/bin/sh -c 'exec "$$0" -c "$$1" switchboard' ${SWITCHBOARD_POLYBAR_BIN} ${SWITCHBOARD_POLYBAR_CONFIG}
Restart=on-failure
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
