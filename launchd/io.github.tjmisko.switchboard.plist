<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The macOS analogue of systemd/switchboard.service.

  Install to ~/Library/LaunchAgents/ with __HOME__ replaced by the real home
  directory: launchd does no variable expansion in ProgramArguments, so the
  paths must be literal.

  Differences from the systemd unit that are worth knowing:
    - No socket activation. launchd offers it, but switchboard creates and owns
      its own socket, so RunAtLoad + KeepAlive is the honest mapping.
    - KeepAlive.SuccessfulExit=false restarts on a crash but respects a clean
      exit, which is what `switchboard-ctl` shutdown paths expect.
    - ThrottleInterval keeps a crash-looping daemon from spinning.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.tjmisko.switchboard</string>

	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.local/share/switchboard/current/switchboard</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>ProcessType</key>
	<string>Background</string>

	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/switchboard.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/switchboard.log</string>
</dict>
</plist>
