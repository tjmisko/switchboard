#!/usr/bin/env bash
# Build one Waybar config containing an existing top bar and Switchboard's
# bottom bar. Sources are never edited; the completed file is atomically moved
# over the requested destination after structural preflight checks.

set -euo pipefail

if [[ $# -ne 3 ]]; then
	printf 'usage: %s TOP.jsonc BOTTOM.jsonc OUTPUT.jsonc\n' "${0##*/}" >&2
	exit 2
fi

top=$1
bottom=$2
output=$3

for source in "$top" "$bottom"; do
	[[ -f "$source" ]] || { printf 'merge-waybar-config: missing %s\n' "$source" >&2; exit 1; }
done
[[ "$output" != "$top" && "$output" != "$bottom" ]] || {
	printf 'merge-waybar-config: output must not overwrite either source\n' >&2
	exit 1
}

[[ $(grep -c '"name"[[:space:]]*:[[:space:]]*"top"' "$top" || true) -eq 1 ]] || {
	printf 'merge-waybar-config: top source must contain exactly one named top bar\n' >&2
	exit 1
}
[[ $(grep -c '"name"[[:space:]]*:[[:space:]]*"claude"' "$bottom" || true) -eq 1 ]] || {
	printf 'merge-waybar-config: bottom source must contain exactly one named claude bar\n' >&2
	exit 1
}
for key in on-sigusr1 on-sigusr2 start_hidden; do
	if grep -q "\"$key\"" "$top" || grep -q "\"$key\"" "$bottom"; then
		printf 'merge-waybar-config: source already defines %s; refusing an ambiguous signal contract\n' "$key" >&2
		exit 1
	fi
done
grep -q 'bottom-waybar.ready' "$bottom" || {
	printf 'merge-waybar-config: bottom source lacks the readiness handshake\n' >&2
	exit 1
}
grep -q '/proc/\$PPID/stat' "$bottom" || {
	printf 'merge-waybar-config: readiness handshake lacks a process-generation fence\n' >&2
	exit 1
}

mkdir -p "$(dirname -- "$output")"
tmp=$(mktemp "$(dirname -- "$output")/.combined-waybar.XXXXXX")
cleanup() { [[ -e "$tmp" ]] && rm -- "$tmp"; }
trap cleanup EXIT

# Both inputs are Waybar config arrays. Keep their comments and object bodies,
# drop only the outer array delimiters, and inject the per-window signal map
# immediately after each stable name. SIGUSR1 remains the top/master toggle;
# SIGUSR2 belongs exclusively to the Switchboard bottom window.
awk '
	function content(path, kind, line, seen_open, seen_close) {
		seen_open = 0
		seen_close = 0
		while ((getline line < path) > 0) {
			if (!seen_open) {
				if (line ~ /^[[:space:]]*\[[[:space:]]*$/) { seen_open = 1 }
				continue
			}
			if (line ~ /^[[:space:]]*\][[:space:]]*$/) { seen_close = 1; break }
			print line
			if (kind == "top" && line ~ /"name"[[:space:]]*:[[:space:]]*"top"/) {
				print "    \"on-sigusr1\": \"toggle\","
				print "    \"on-sigusr2\": \"noop\","
			}
			if (kind == "bottom" && line ~ /"name"[[:space:]]*:[[:space:]]*"claude"/) {
				print "    \"start_hidden\": true,"
				print "    \"on-sigusr1\": \"noop\","
				print "    \"on-sigusr2\": \"toggle\","
			}
		}
		close(path)
		if (!seen_open || !seen_close) exit 3
	}
	BEGIN {
		print "// Generated by scripts/merge-waybar-config. Edit the source configs, not this file."
		print "["
		content(ARGV[1], "top")
		print ","
		content(ARGV[2], "bottom")
		print "]"
		exit 0
	}
' "$top" "$bottom" > "$tmp" || {
	printf 'merge-waybar-config: malformed source array\n' >&2
	exit 1
}

chmod 600 "$tmp"
mv -- "$tmp" "$output"
trap - EXIT
